{
  "name": "vjobe-community",
  "version": "1.0.0",
  "description": "A private, local desktop job application tracker for macOS and Windows.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "test:windows": "node windows-smoke.cjs",
    "build:mac": "electron-packager . \"VJOBE Community\" --platform=darwin --arch=arm64,x64 --icon=assets/app_icon.icns --out=dist --overwrite --ignore=\"^/(?:\\.git|\\.meminisse|tests|backups|private|attachments)(?:/|$)\""
  },
  "keywords": [
    "jobs",
    "tracker",
    "desktop",
    "mac"
  ],
  "author": "VJOBE contributors",
  "license": "MIT",
  "build": {
    "appId": "com.vjobe.community",
    "productName": "VJOBE Community",
    "files": ["main.js", "preload.js", "src/app.js", "src/index.html", "src/styles.css", "assets/**/*"],
    "win": {
      "target": "nsis",
      "icon": "assets/app_icon.png"
    },
    "nsis": {
      "artifactName": "VJOBE-Community-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "26.18.0",
    "electron-packager": "^17.1.2",
    "playwright": "1.65.0"
  }
}
